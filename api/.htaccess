# TECNO-MARKET API - reescritura de rutas
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Conservar la cabecera Authorization (necesaria para el JWT de P4)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Enviar todo lo que no sea archivo o carpeta real al front controller
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>
